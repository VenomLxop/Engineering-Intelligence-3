# Copy this to .streamlit/secrets.toml for LOCAL testing of the secrets path
# (optional -- locally you can just `export ANTHROPIC_API_KEY=...` instead).
#
# On Streamlit Community Cloud, you do NOT create this file yourself --
# paste the same content into the app's "Secrets" box in the dashboard
# (App settings -> Secrets) instead. Never commit a real secrets.toml.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"
